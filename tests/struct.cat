import "std";
proc main() {
    let student := .{.name = "Bob", .age = 15, .height = 175};

    foo(student);

    let new_student := new_year(student);
    foo(new_student);
}

proc foo(student: {.name: *char, .age: int, .height: int}) {
    print_strz(student.name);
    print_int(student.age);
    print_int(student.height);

}

fn new_year(student: {.name: *char, .age: int, .height: int}): {.name: *char, .age: int, .height: int} {
    ret .{.name = "Tom", .age = student.age + 1, .height = student.height};
}
