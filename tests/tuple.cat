import "std";
proc main() {
    let tuple := .{1, 3.14, "hello world", .{2, .[1, 2, 3]}};
    foo(tuple);
    let tuple2 := bar(.{1, 3.14});
    print_double(tuple2[0]);
    print_int(tuple2[1]);
}


proc foo(tuple: {int, double, *char, {int, [3]int}}) {
    print_int(tuple[0]);
    print_double(tuple[1]);
    print_strz(tuple[2]);
    print_int(tuple[3][0]);

    print_int(tuple[3][1][0]);
    print_int(tuple[3][1][1]);
    print_int(tuple[3][1][2]);
}


fn bar(tuple: {int, double}): {double, int} {
    ret .{tuple[1], tuple[0]};
}
