import "std";
proc main() {
    whatday(1);
    whatday(3);
    whatday(7);
    whatday(0);

    if !false {
	print_strz("not works");
    }
    if !(1 == 2) {
	print_strz("not works 2");
    }
    if 1.0 < 2.0 {
	print_strz("double comparison works");
    }
    if 1.0 as float < 2.0 as float {
	print_strz("float comparison works");
    }

}

proc whatday(x: int) {
    if x == 1 {
        print_strz("Monday");
    } else if x == 2 {
        print_strz("Tuesday");
    } else if x == 3 {
        print_strz("Wednesday");
    } else if x == 4 {
        print_strz("Thursday");
    } else if x == 5 {
        print_strz("Friday");
    } else if x == 6 {
        print_strz("Saturday");
    } else if x == 7 {
        print_strz("Sunday");
    } else {
        print_strz("Not a day!");
    }
}

