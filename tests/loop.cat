import "std";
proc main() {
    let x := 1;
    loop x < 8{
        whatday(x);
        x = x + 1;
    }
}

proc whatday(x: int) {
    if x == 1 {
        print_strz("Monday");
    } else if x == 2 {
        print_strz("Tuesday");
    } else if x == 3 {
        print_strz("Wednesday");
    } else if x == 4 {
        print_strz("Thursday");
    } else if x == 5 {
        print_strz("Friday");
    } else if x == 6 {
        print_strz("Saturday");
    } else if x == 7 {
        print_strz("Sunday");
    } else {
        print_strz("Not a day!");
    }
}
