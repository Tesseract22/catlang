import "std";
type Student: {.name: *char, .age: int, .height: int};
type Person: Student;
proc main() {
    let student := {.name = "Bob", .age = 15, .height = 175 };
    foo(student);

    let new_student := new_year(student);
    foo(new_student);
}

proc foo(student: Student) {
    print_strz(student.name);
    print_int(student.age);
    print_int(student.height);

}

fn new_year(person: Person): Person {
    ret {.name = person.name, .age = person.age + 1, .height = person.height};
}
