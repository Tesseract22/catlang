import "std";
proc main() {
    let a := -5;
    let b := 7;
    print_int((a + b) * (a + b));
    print_int(a*a + 2*a*b + b*b);


    let x := 60.0;
    let y := 420.0 / x + 5.0 * 10.0 - 2.0;
    print_double(y);

    let yf := y as float;
    let zf := 10.0 as float;
    print_float(1.0 + yf + zf + 2.0);
}
